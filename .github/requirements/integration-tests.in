# Hash-pinned lock for CI's integration tests (.github/workflows/build.yml, job "integration"; the same packages as
# tests/requirements-integration.txt). After changing either, regenerate integration-tests.txt from the repository
# root with:
#   uv pip compile .github/requirements/integration-tests.in --generate-hashes --python-version 3.13.2 \
#     --python-platform x86_64-unknown-linux-gnu --no-header -o .github/requirements/integration-tests.txt
-r ../../tests/requirements-integration.txt
